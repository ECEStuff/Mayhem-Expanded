		<line linenr="020" indent="&#160;">
			<comment>* Eliminating the territorial owner's Huge Ship helps the claimant.</comment>
		</line>
		<line linenr="021" indent="&#160;">
			<var>$loyaltyRace</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>$claimRace</var>
		</line>
		<line linenr="022" indent="&#160;" />
		<line linenr="023" indent="">
			<text>else</text>
