			<text> </text>
			<var>$loyaltyRace</var>
		</line>
		<line linenr="030" indent="&#160;">
			<text>return</text>
			<text> </text>
			<var>null</var>
		</line>
		<line linenr="031" indent="" />
		<line linenr="032" indent="">
			<comment>* Expanded 2.2: Boarding and oxygen hacking are underhanded actions.</comment>
