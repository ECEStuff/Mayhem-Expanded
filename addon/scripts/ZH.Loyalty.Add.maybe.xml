	<sourcetext>
		<line linenr="001" indent="">
			<comment>* Awards Loyalty for helping one side of an active territorial claim.</comment>
		</line>
		<line linenr="002" indent="">
			<comment>* $raceKilled is the owner of the destroyed/boarded Huge Ship. 2 points are awarded for each Huge Ship destroyed.</comment>
		</line>
		<line linenr="003" indent="">
			<comment>* Add-Ons 2.2: Reworked - instead of random Loyalty, now awards Loyalty during active claims.</comment>
		</line>
		<line linenr="004" indent="" />
		<line linenr="005" indent="">
			<var>$claimRace</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>$sector</var>
			<text>-&gt;</text>
			<text> </text>
			<text>get</text>
			<text> </text>
			<text>local</text>
			<text> </text>
			<text>variable</text>
			<text>:</text>
			<text> </text>
			<text>name</text>
			<text>=</text>
			<text>'mayhem_claimRace'</text>
		</line>
		<line linenr="006" indent="" />
		<line linenr="007" indent="">
			<comment>* No territorial dispute, no Loyalty.</comment>
		</line>
		<line linenr="008" indent="">
			<text>skip</text>
			<text> </text>
			<text>if</text>
			<text> </text>
			<var>$claimRace</var>
		</line>
		<line linenr="009" indent="&#160;">
			<text>return</text>
			<text> </text>
			<var>null</var>
		</line>
		<line linenr="010" indent="" />
		<line linenr="011" indent="">
			<var>$sectorOwner</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>$sector</var>
			<text>-&gt;</text>
			<text> </text>
			<text>get</text>
			<text> </text>
			<text>owner</text>
			<text> </text>
			<text>race</text>
		</line>
		<line linenr="012" indent="" />
		<line linenr="013" indent="">
			<comment>* Player, Phanon, and Unknown (neutral) sectors are invalid.</comment>
		</line>
		<line linenr="014" indent="">
			<text>do</text>
			<text> </text>
			<text>if</text>
			<text> </text>
			<var>$sectorOwner</var>
			<text> </text>
			<text>==</text>
			<text> </text>
			<var>[Player]</var>
			<text> </text>
			<text>OR</text>
			<text> </text>
			<var>$sectorOwner</var>
			<text> </text>
			<text>==</text>
			<text> </text>
			<var>[Phanon]</var>
			<text> </text>
			<text>OR</text>
			<text> </text>
			<var>$sectorOwner</var>
			<text> </text>
			<text>==</text>
			<text> </text>
			<var>[Unknown]</var>
		</line>
		<line linenr="015" indent="&#160;">
			<text>return</text>
			<text> </text>
			<var>null</var>
		</line>
		<line linenr="016" indent="" />
		<line linenr="017" indent="">
			<var>$loyaltyRace</var>
			<text> </text>
			<text>=</text>
			<text> </text>
			<var>null</var>
		</line>
		<line linenr="018" indent="" />
		<line linenr="019" indent="">
			<text>if</text>
